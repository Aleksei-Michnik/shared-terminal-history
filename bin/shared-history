#!/usr/bin/env bash
# Inspect and maintain the shared terminal history.
# https://github.com/Aleksei-Michnik/shared-terminal-history

set -uo pipefail

CONFIG="${SHARED_HISTORY_CONFIG:-$HOME/.config/shared-terminal-history/config}"
[ -r "$CONFIG" ] && . "$CONFIG"

HIST_FILE="${SHARED_HISTFILE:-$HOME/.bash_history}"
DATA_DIR="${SHARED_HISTORY_DATA_DIR:-$HOME/.local/share/shared-terminal-history}"
INSTALL_DIR="${SHARED_HISTORY_HOME:-$HOME/.config/shared-terminal-history}"
AUDIT_LOG="$DATA_DIR/agent-commands.jsonl"
LOCK_FILE="$DATA_DIR/lock"
MAX_COMMANDS="${SHARED_HISTORY_MAX:-19999}"

usage() {
    cat <<'EOF'
Usage: shared-history <command>

  status            Where history lives, how full it is, and whether wiring is intact
  search <pattern>  Grep the shared history, oldest first, with timestamps
  tail [n]          Last n commands (default 20) with timestamps
  agents [n]        Last n commands recorded by coding agents, with cwd (default 20)
  trim              Truncate the file to the most recent SHARED_HISTORY_MAX commands
  doctor            Check every part of the setup and report what is broken

All terminals share one file; `status` prints its path.
EOF
}

# Emit "<epoch>\t<command>" for each entry in a bash history file.
read_entries() {
    [ -f "$1" ] || return 0
    awk '
        /^#[0-9]+$/ { ts = substr($0, 2); next }
        { printf "%s\t%s\n", (ts == "" ? "0" : ts), $0; ts = "" }
    ' "$1"
}

format_entries() {
    while IFS=$'\t' read -r epoch line; do
        if [ "$epoch" = "0" ]; then
            printf '%-19s  %s\n' "(no timestamp)" "$line"
        else
            printf '%-19s  %s\n' "$(date -d "@$epoch" '+%F %T' 2>/dev/null || date -r "$epoch" '+%F %T' 2>/dev/null)" "$line"
        fi
    done
}

count_commands() {
    [ -f "$HIST_FILE" ] || { echo 0; return; }
    grep -cv '^#[0-9]\+$' "$HIST_FILE" 2>/dev/null || echo 0
}

cmd_status() {
    echo "history file : $HIST_FILE"
    echo "commands     : $(count_commands) / $MAX_COMMANDS"
    echo "size         : $( [ -f "$HIST_FILE" ] && du -h "$HIST_FILE" | cut -f1 || echo '-' )"
    echo "audit log    : $AUDIT_LOG ($( [ -f "$AUDIT_LOG" ] && wc -l <"$AUDIT_LOG" || echo 0 ) agent commands)"
    echo
    cmd_doctor
}

cmd_doctor() {
    local rc=0
    check() {
        if [ "$2" = "ok" ]; then printf '  OK    %s\n' "$1"; else printf '  FAIL  %s\n' "$1"; rc=1; fi
    }

    echo "checks:"
    check "shell-init.bash installed" "$( [ -r "$INSTALL_DIR/shell-init.bash" ] && echo ok )"
    check "~/.bashrc sources shell-init.bash" \
        "$(grep -qF 'shared-terminal-history/shell-init.bash' "$HOME/.bashrc" 2>/dev/null && echo ok)"
    check "record-command installed and executable" "$( [ -x "$INSTALL_DIR/record-command" ] && echo ok )"
    check "jq installed (needed for agent hooks)" "$(command -v jq >/dev/null && echo ok)"
    check "flock installed (append locking)" "$(command -v flock >/dev/null && echo ok)"

    # Agent integrations are optional; report them without failing the run.
    echo "agents:"
    local settings="$HOME/.claude/settings.json"
    if [ -f "$settings" ] && command -v jq >/dev/null 2>&1; then
        if jq -e '.hooks.PostToolUse[]? | select(.matcher == "Bash") | .hooks[]
                  | select(.command | test("record-command"))' "$settings" >/dev/null 2>&1; then
            printf '  OK    Claude Code hook registered\n'
        else
            printf '  --    Claude Code present but hook not registered (see agents/claude-code.md)\n'
        fi
    else
        printf '  --    Claude Code not detected\n'
    fi

    # Whether a given terminal is syncing cannot be checked from here: PROMPT_COMMAND
    # is not exported, so a child process cannot see it. Check inside the terminal:
    #   declare -p PROMPT_COMMAND
    return $rc
}

cmd_search() {
    [ $# -ge 1 ] || { echo "usage: shared-history search <pattern>" >&2; return 2; }
    read_entries "$HIST_FILE" | grep -i -- "$1" | format_entries
}

cmd_tail() { read_entries "$HIST_FILE" | tail -n "${1:-20}" | format_entries; }

cmd_agents() {
    [ -f "$AUDIT_LOG" ] || { echo "no agent commands recorded yet" >&2; return 1; }
    command -v jq >/dev/null 2>&1 || { echo "jq is required for this view" >&2; return 1; }
    tail -n "${1:-20}" "$AUDIT_LOG" |
        jq -r '"\(.time)  [\(.source)]  \(.cwd // "?")\n    \(.command | gsub("\n"; "\n    "))"'
}

cmd_trim() {
    local count drop
    count=$(count_commands)
    if [ "$MAX_COMMANDS" = "-1" ]; then
        echo "SHARED_HISTORY_MAX is -1 (unlimited) — nothing to trim"; return 0
    fi
    if [ "$count" -le "$MAX_COMMANDS" ]; then
        echo "$count commands, at or under the $MAX_COMMANDS cap — nothing to do"; return 0
    fi
    drop=$((count - MAX_COMMANDS))
    (
        flock -x 9 2>/dev/null || true
        # Keep each surviving command together with its own timestamp line.
        awk -v drop="$drop" '
            /^#[0-9]+$/ { pending = $0; next }
            { seen++
              if (seen > drop) { if (pending != "") print pending; print }
              pending = "" }
        ' "$HIST_FILE" >"$HIST_FILE.trim.$$" && mv "$HIST_FILE.trim.$$" "$HIST_FILE"
        echo "trimmed $drop old commands, $MAX_COMMANDS remain"
    ) 9>"$LOCK_FILE"
}

case "${1:-}" in
    status) shift; cmd_status "$@" ;;
    doctor) shift; cmd_doctor "$@" ;;
    search) shift; cmd_search "$@" ;;
    tail)   shift; cmd_tail "$@" ;;
    agents) shift; cmd_agents "$@" ;;
    trim)   shift; cmd_trim "$@" ;;
    ""|-h|--help|help) usage ;;
    *) echo "unknown command: $1" >&2; usage >&2; exit 2 ;;
esac
